     "name": "stdout",
     "output_type": "stream",
     "text": [
      "N upper branch: 1106, N lower branch: 2260\n"
     ]
    }
   ],
   "source": [
    "AV_MIN = 12  # same threshold used to define the lower/upper branch split\n",
    "\n",
    "upper_idx = np.where((f360 - f480 > 0.15 + (1.5 / 6) * (f162 - f210)) & (av_estimate > AV_MIN))\n",
    "lower_idx = np.where((f360 - f480 <= 0.15 + (1.5 / 6) * (f162 - f210)) & (av_estimate > AV_MIN))\n",
    "\n",
    "print(f'N upper branch: {len(upper_idx[0])}, N lower branch: {len(lower_idx[0])}')\n"
   ]
