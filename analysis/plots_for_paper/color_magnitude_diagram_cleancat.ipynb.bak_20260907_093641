    "ext = CT06_MWLoc()\n",
    "def plot_extvec_cmd(ax, color1, mag1, ext=CT06_MWGC(), extvec_scale=200, start=None,\n",
    "                    color='y', head_width=0.5, color1_data=None, mag1_data=None, label=None, fontsize=15):\n",
